---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Página no encontrada | Javi" noindex>
  <main id="contenido" class="section-shell not-found" tabindex="-1">
    <p class="section-eyebrow">404</p>
    <h1>Esta página no está aquí.</h1>
    <p>Puede que el enlace haya cambiado. El portfolio sigue en el inicio.</p>
    <p lang="en">This page could not be found. You can return to the portfolio below.</p>
    <nav aria-label="Volver al portfolio">
      <a class="button button-primary" href="/">Portfolio en español</a>
      <a class="text-link" href="/en/" lang="en">Portfolio in English</a>
    </nav>
  </main>
</Layout>
