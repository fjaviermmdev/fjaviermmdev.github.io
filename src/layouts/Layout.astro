---
export interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Javi | Ingeniero de software',
	description = 'Portfolio de Javi Martínez, ingeniero de software especializado en desarrollo backend y ciberseguridad',
} = Astro.props;
---

<!doctype html>
<html lang="es" data-lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#ffffff" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="canonical" href="https://fjaviermm.dev/" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content={description}
			data-en="Portfolio of Javi Martínez, software engineer specializing in backend development and cybersecurity"
			data-es="Portfolio de Javi Martínez, ingeniero de software especializado en desarrollo backend y ciberseguridad"
		/>
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Portfolio de Javi" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:locale:alternate" content="en_GB" />
		<meta property="og:url" content="https://fjaviermm.dev/" />
		<meta property="og:title" content="Javi | Ingeniero de software" />
		<meta property="og:description" content="Portfolio de Javi Martínez, ingeniero de software especializado en desarrollo backend y ciberseguridad" />
		<meta property="og:image" content="https://fjaviermm.dev/javi.jpg" />
		<meta property="og:image:alt" content="Francisco Javier Martínez Martínez en Murcia" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content="Javi | Ingeniero de software" />
		<meta name="twitter:description" content="Portfolio de Javi Martínez, ingeniero de software especializado en desarrollo backend y ciberseguridad" />
		<meta name="twitter:image" content="https://fjaviermm.dev/javi.jpg" />
		<meta name="robots" content="index, follow" />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Person',
			name: 'Francisco Javier Martínez Martínez',
			alternateName: 'Javi Martínez',
			url: 'https://fjaviermm.dev/',
			image: 'https://fjaviermm.dev/javi.jpg',
			jobTitle: 'Software Engineering Analyst I',
			worksFor: { '@type': 'Organization', name: 'Lynx Tech' },
			alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad de Murcia' },
			sameAs: ['https://linkedin.com/in/fjaviermm', 'https://github.com/fjaviermmdev'],
			knowsAbout: ['Python', 'Backend development', 'Cybersecurity', 'Cloud computing', 'REST APIs'],
		})} />
		<title data-en="Javi | Software engineer" data-es="Javi | Ingeniero de software">{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<script is:inline>
			(() => {
				const savedLanguage = localStorage.getItem('language');
				const language = savedLanguage || (navigator.language.startsWith('es') ? 'es' : 'en');
				document.documentElement.dataset.lang = language;
				document.documentElement.lang = language;
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#contenido" data-en="Skip to content" data-es="Saltar al contenido">Saltar al contenido</a>
		<slot />

		<footer class="site-footer">
			<div class="footer-inner">
				<p>© 2026 Francisco Javier Martínez Martínez</p>
				<p data-en="Murcia, Spain." data-es="Murcia, España.">Murcia, España.</p>
				<a href="#inicio" data-en="Back to top ↑" data-es="Volver arriba ↑">Volver arriba ↑</a>
			</div>
		</footer>

		<script>
			type Language = 'es' | 'en';
			const getLanguage = (): Language =>
				document.documentElement.dataset.lang === 'en' ? 'en' : 'es';

			function updateLanguageContent(language: Language) {
				document.documentElement.lang = language;
				document.documentElement.dataset.lang = language;
				localStorage.setItem('language', language);

				document.querySelectorAll<HTMLElement>('[data-en][data-es]').forEach((element) => {
					const value = element.dataset[language];
					if (!value) return;

					if (element instanceof HTMLMetaElement) {
						element.content = value;
					} else if (element instanceof HTMLTitleElement) {
						document.title = value;
					} else {
						element.innerHTML = value;
					}
				});

				document.querySelectorAll<HTMLElement>('[data-aria-en][data-aria-es]').forEach((element) => {
					const value = language === 'en' ? element.dataset.ariaEn : element.dataset.ariaEs;
					if (value) element.setAttribute('aria-label', value);
				});

				document.querySelectorAll<HTMLAnchorElement>('[data-cv-link]').forEach((link) => {
					link.href = language === 'en' ? '/CV_Javi-EN-public.pdf' : '/CV_Javi-ES-public.pdf';
				});

				document.dispatchEvent(new CustomEvent('languageChanged', { detail: language }));
			}

			function toggleLanguage() {
				updateLanguageContent(getLanguage() === 'es' ? 'en' : 'es');
			}

			Object.assign(window, { toggleLanguage, updateLanguageContent });

			document.addEventListener('DOMContentLoaded', () => {
				updateLanguageContent(getLanguage());

				const revealObserver = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('is-visible');
							revealObserver.unobserve(entry.target);
						});
					},
					{ threshold: 0.12 },
				);

				document.querySelectorAll('.reveal').forEach((element) => revealObserver.observe(element));
			});
		</script>
	</body>
</html>
