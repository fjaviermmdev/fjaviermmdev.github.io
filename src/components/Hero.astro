---
import { cvPath, type Language } from '../lib/i18n';
interface Props { lang: Language }
const { lang } = Astro.props;
import { Picture } from 'astro:assets';
import portrait from '../assets/javi.jpg';
---

<section id="inicio" class="hero-section">
	<div class="hero-shell">
		<div class="hero-intro reveal is-visible">
			<p class="hero-kicker">Francisco Javier Martínez Martínez</p>
			<h1>
				<span>{lang === 'en' ? "Software engineer." : "Ingeniero de software."}</span>
				<strong>{lang === 'en' ? "Backend and cybersecurity." : "Backend y ciberseguridad."}</strong>
			</h1>
			<p class="hero-lead">{lang === 'en' ? "I work on backend development at Lynx Tech, mainly with Python, APIs and cloud services. I am also studying for a master's degree in Cybersecurity at the University of Murcia." : "Me dedico al desarrollo backend en Lynx Tech, principalmente con Python, APIs y servicios cloud. También curso un máster en Ciberseguridad en la Universidad de Murcia."}</p>
			<div class="hero-actions">
				<a class="button button-primary" href={cvPath(lang)} data-cv-link target="_blank" rel="noopener noreferrer">{lang === 'en' ? "View CV" : "Ver CV"}</a>
				<a class="text-link" href="#experiencia">{lang === 'en' ? "View experience" : "Ver experiencia"}</a>
			</div>
		</div>

		<figure class="hero-media reveal is-visible">
			<Picture src={portrait} alt={lang === 'en' ? 'Javi in Murcia, with the cathedral in the background' : 'Javi en Murcia, con la catedral al fondo'} formats={['avif', 'webp']} widths={[280, 420, 560, 840]} sizes="(max-width: 760px) 240px, (max-width: 980px) 260px, 300px" width={300} loading="eager" fetchpriority="high" class="hero-image" />
			<figcaption>
				<span>{lang === 'en' ? "Murcia, Spain" : "Murcia, España"}</span>
			</figcaption>
		</figure>
	</div>

</section>
