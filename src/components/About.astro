---
import type { Language } from '../lib/i18n';
interface Props { lang: Language }
const { lang } = Astro.props;
const skillGroups = [
  { es: 'Backend', en: 'Backend', skills: ['Python', 'Java', 'Go', 'Flask', 'FastAPI', 'Django', 'REST APIs', 'SQLAlchemy'] },
  { es: 'Datos', en: 'Data', skills: ['PostgreSQL', 'MySQL', 'MongoDB', 'Elasticsearch', 'OpenSearch', 'InfluxDB', 'Big Data'] },
  { es: 'Cloud y DevOps', en: 'Cloud and DevOps', skills: ['Docker', 'Kubernetes', 'AWS ECS', 'AWS Lambda', 'Amazon S3', 'Jenkins', 'GitHub Actions', 'GitLab', 'NGINX', 'Traefik'] },
  { es: 'Seguridad', en: 'Security', skills: ['Cybersecurity', 'Keycloak', 'XACML', 'IAM', 'Pentesting'] },
  { es: 'Sistemas', en: 'Systems', skills: ['Linux', 'Bash', 'Microservices', 'Distributed systems', 'MQTT', 'FIWARE'] },
  { es: 'Calidad', en: 'Quality', skills: ['PyTest', 'k6', 'Locust', 'Postman', 'OpenAPI'] },
];
---
<section id="sobre-mi" class="profile-section">
  <div class="section-shell">
    <header class="section-heading reveal" data-section="01">
      <p class="section-eyebrow">{lang === 'en' ? 'Profile' : 'Perfil'}</p>
      <h2>{lang === 'en' ? 'Backend, systems and security.' : 'Backend, sistemas y seguridad.'}</h2>
      <p class="section-intro">{lang === 'en'
        ? 'I started my professional career in applied research at Odin Solutions, working with IoT and identity systems. Today I develop financial software. Along the way, my work has included writing services, deploying them and diagnosing production issues.'
        : 'Empecé mi trayectoria profesional en investigación aplicada, trabajando con IoT y sistemas de identidad en Odin Solutions. Ahora desarrollo software financiero. En ese recorrido he trabajado tanto en los servicios como en sus despliegues y en el diagnóstico de incidencias en producción.'}</p>
    </header>
    <div class="focus-areas">
      <article class="focus-area reveal">
        <span aria-hidden="true">01</span>
        <h3>{lang === 'en' ? 'Backend development' : 'Desarrollo backend'}</h3>
        <p>{lang === 'en' ? 'APIs, data integration and automated tests.' : 'APIs, integración de datos y pruebas automáticas.'}</p>
        <p class="focus-tools">Python · SQL · PyTest</p>
      </article>
      <article class="focus-area reveal">
        <span aria-hidden="true">02</span>
        <h3>{lang === 'en' ? 'Systems and deployment' : 'Sistemas y despliegues'}</h3>
        <p>{lang === 'en' ? 'Containers, pipelines and services in production.' : 'Contenedores, pipelines y servicios en producción.'}</p>
        <p class="focus-tools">AWS · Docker · CI/CD</p>
      </article>
      <article class="focus-area reveal">
        <span aria-hidden="true">03</span>
        <h3>{lang === 'en' ? 'Application security' : 'Seguridad de aplicaciones'}</h3>
        <p>{lang === 'en' ? 'Identity, access policies and further study in cybersecurity.' : 'Identidad, políticas de acceso y formación en ciberseguridad.'}</p>
        <p class="focus-tools">Keycloak · XACML · IAM</p>
      </article>
    </div>
    <details class="skills-details">
      <summary><span>{lang === 'en' ? 'All technologies and tools' : 'Todas las tecnologías y herramientas'}</span><span class="details-icon" aria-hidden="true">+</span></summary>
      <p class="skills-context">{lang === 'en' ? 'Tools I have used across professional work, personal projects and studies. Not all belong to the same role or period.' : 'Herramientas que he utilizado en el trabajo, en proyectos propios y durante mi formación. No todas corresponden al mismo puesto o etapa.'}</p>
    <div class="skills-grid">
      {skillGroups.map((group, index) => (
        <section class="skill-group reveal" aria-labelledby={`skill-${index}`}>
          <h3 id={`skill-${index}`}>{group[lang]}</h3>
          <ul>{group.skills.map((skill) => <li>{skill}</li>)}</ul>
        </section>
      ))}
    </div>
    </details>
  </div>
</section>
