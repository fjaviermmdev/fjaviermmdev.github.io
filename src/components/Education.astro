---
const education = [
	{
		titleEs: 'Máster en Ciberseguridad',
		titleEn: "Master's in Cybersecurity",
		institutionEs: 'Universidad de Murcia',
		institutionEn: 'University of Murcia',
		period: '2025 — 2027',
		statusEs: 'En curso',
		statusEn: 'In progress',
		descriptionEs: 'Especialización en análisis de ciberseguridad, hacking ético, gestión de incidentes, criptografía, seguridad software y gobernanza.',
		descriptionEn: 'Specialization in cybersecurity analysis, ethical hacking, incident management, cryptography, software security and governance.',
		topics: ['Ethical hacking', 'Cryptography', 'Cyber intelligence', 'Software security', 'Incident response'],
	},
	{
		titleEs: 'Grado en Ingeniería Informática',
		titleEn: 'BSc in Computer Engineering',
		institutionEs: 'Universidad de Murcia · Tecnologías de la Información',
		institutionEn: 'University of Murcia · Information Technologies',
		period: '2020 — 2024',
		statusEs: 'Completado',
		statusEn: 'Completed',
		descriptionEs: 'Formación en desarrollo backend y frontend, sistemas distribuidos, bases de datos, redes, sistemas operativos, cloud y ciberseguridad.',
		descriptionEn: 'Training in backend and frontend development, distributed systems, databases, networks, operating systems, cloud and cybersecurity.',
		topics: ['Python', 'Java', 'Linux', 'Networking', 'Databases', 'Distributed systems', 'Cybersecurity'],
	},
];
---

<section id="educacion" class="education-section">
	<div class="section-shell">
		<header class="section-heading reveal">
			<p class="section-eyebrow" data-en="Education" data-es="Formación">Formación</p>
			<h2 data-en="Academic background." data-es="Formación académica.">Formación académica.</h2>
			<p class="section-intro" data-en="Computer Engineering at the University of Murcia and an ongoing specialization in cybersecurity." data-es="Ingeniería Informática en la Universidad de Murcia y especialización en ciberseguridad actualmente en curso.">Ingeniería Informática en la Universidad de Murcia y especialización en ciberseguridad actualmente en curso.</p>
		</header>

		<div class="education-grid">
			{education.map((item, index) => (
				<article class:list={['education-card', 'reveal', { 'education-card-featured': index === 0 }]}>
					<div class="education-topline">
						<span class="education-year">{item.period}</span>
						<span class="education-status" data-en={item.statusEn} data-es={item.statusEs}>{item.statusEs}</span>
					</div>
					<div class="education-content">
						<p class="education-institution" data-en={item.institutionEn} data-es={item.institutionEs}>{item.institutionEs}</p>
						<h3 data-en={item.titleEn} data-es={item.titleEs}>{item.titleEs}</h3>
						<p class="education-description" data-en={item.descriptionEn} data-es={item.descriptionEs}>{item.descriptionEs}</p>
					</div>
					<ul class="technology-list">
						{item.topics.map((topic) => <li>{topic}</li>)}
					</ul>
				</article>
			))}
		</div>

		<div class="languages-strip reveal">
			<div>
				<p class="content-label" data-en="Languages" data-es="Idiomas">Idiomas</p>
				<h3 data-en="Spanish and English" data-es="Español e inglés">Español e inglés</h3>
			</div>
			<dl class="language-levels">
				<div><dt data-en="Spanish" data-es="Español">Español</dt><dd data-en="Native" data-es="Nativo">Nativo</dd></div>
				<div><dt data-en="English" data-es="Inglés">Inglés</dt><dd>B2 Cambridge</dd></div>
			</dl>
		</div>
	</div>
</section>
