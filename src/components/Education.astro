---
import type { Language } from '../lib/i18n';
interface Props { lang: Language }
const { lang } = Astro.props;
const education = [
	{
		titleEs: 'Máster en Ciberseguridad',
		titleEn: "Master's in Cybersecurity",
		institutionEs: 'Universidad de Murcia',
		institutionEn: 'University of Murcia',
		period: '2025 — 2027',
		statusEs: 'En curso',
		statusEn: 'In progress',
		descriptionEs: 'Especialización en análisis de ciberseguridad, hacking ético, gestión de incidentes, criptografía, seguridad software y gobernanza.',
		descriptionEn: 'Specialization in cybersecurity analysis, ethical hacking, incident management, cryptography, software security and governance.',
	},
	{
		titleEs: 'Grado en Ingeniería Informática',
		titleEn: 'BSc in Computer Engineering',
		institutionEs: 'Universidad de Murcia · Tecnologías de la Información',
		institutionEn: 'University of Murcia · Information Technologies',
		period: '2020 — 2024',
		statusEs: 'Completado',
		statusEn: 'Completed',
		descriptionEs: 'Formación en desarrollo backend y frontend, sistemas distribuidos, bases de datos, redes, sistemas operativos, cloud y ciberseguridad.',
		descriptionEn: 'Training in backend and frontend development, distributed systems, databases, networks, operating systems, cloud and cybersecurity.',
	},
];
---

<section id="educacion" class="education-section">
	<div class="section-shell">
		<header class="section-heading reveal" data-section="03">
			<p class="section-eyebrow">{lang === 'en' ? "Education" : "Formación"}</p>
			<h2>{lang === 'en' ? "Academic background." : "Formación académica."}</h2>
		</header>

		<div class="education-grid">
			{education.map((item) => (
				<article class="education-card reveal">
					<div class="education-topline">
						<span class="education-year">{item.period}</span>
						<span class="education-status">{lang === 'en' ? item.statusEn : item.statusEs}</span>
					</div>
					<div class="education-content">
						<p class="education-institution">{lang === 'en' ? item.institutionEn : item.institutionEs}</p>
						<h3>{lang === 'en' ? item.titleEn : item.titleEs}</h3>
						<p class="education-description">{lang === 'en' ? item.descriptionEn : item.descriptionEs}</p>
					</div>
				</article>
			))}
		</div>

		<div class="languages-strip reveal">
			<div>
				<p class="content-label">{lang === 'en' ? "Languages" : "Idiomas"}</p>
			</div>
			<dl class="language-levels">
				<div><dt>{lang === 'en' ? "Spanish" : "Español"}</dt><dd>{lang === 'en' ? "Native" : "Nativo"}</dd></div>
				<div><dt>{lang === 'en' ? "English" : "Inglés"}</dt><dd>B2 Cambridge</dd></div>
			</dl>
		</div>
	</div>
</section>
