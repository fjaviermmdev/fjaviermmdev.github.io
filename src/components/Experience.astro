---
import type { Language } from '../lib/i18n';
interface Props { lang: Language }
const { lang } = Astro.props;
const roles = [
	{
		company: 'Lynx Tech',
		titleEs: 'Software Engineering Analyst I',
		titleEn: 'Software Engineering Analyst I',
		periodEs: 'Noviembre 2025 — Presente',
		periodEn: 'November 2025 — Present',
		current: true,
		descriptionEs: 'Desarrollo y mantengo APIs REST y paquetes de Python para software de prevención del blanqueo de capitales (AML). También analizo qué cambios necesita cada nueva funcionalidad en las APIs. Propongo criterios de aceptación y coordino esos cambios con desarrolladores de mi equipo que trabajan en otras especialidades.',
		descriptionEn: 'I build and maintain REST APIs and Python packages for anti-money laundering (AML) software. I also work out what each new feature needs from the APIs. I propose acceptance criteria and coordinate those changes with developers on my team who specialise in other areas.',
		highlightsEs: [
			'Diseño modelos de datos, migraciones de esquema y reglas de validación. Al trabajar con operaciones concurrentes, tengo en cuenta cómo mantener la consistencia de los datos.',
			'Cuando diseño cambios en una API, tengo en cuenta el rendimiento y la compatibilidad con las aplicaciones que ya la utilizan.',
			'Desarrollo y despliego servicios backend en AWS y colaboro con otros ingenieros en la integración entre servicios.',
			'Investigo incidencias y escribo pruebas automatizadas y de regresión con pytest. También desarrollo paneles de visualización de datos.',
		],
		highlightsEn: [
			'I design data models, schema migrations and validation rules. When working with concurrent operations, I consider how to keep the data consistent.',
			'When I design API changes, I consider performance and compatibility with applications that already use the API.',
			'I develop and deploy backend services on AWS and work with other engineers on service integrations.',
			'I investigate issues and write automated tests, including regression tests, with pytest. I also build dashboards to visualise data.',
		],
		technologies: ['Python', 'REST APIs', 'AWS', 'pytest', 'CI/CD'],
	},
	{
		company: 'Odin Solutions',
		stages: [
			{ es: ['Investigador junior', 'Julio de 2024 a noviembre de 2025'], en: ['Junior Researcher', 'July 2024 to November 2025'] },
			{ es: ['Trabajo de fin de grado (TFG)', 'Noviembre de 2023 a julio de 2024'], en: ['Bachelor’s thesis', 'November 2023 to July 2024'] },
			{ es: ['Prácticas de desarrollo e investigación', 'Febrero a abril y junio a agosto de 2023'], en: ['Software development and research internships', 'February to April and June to August 2023'] },
		],
		current: false,
		descriptionEs: 'Diseño y desarrollo de soluciones backend para proyectos europeos y nacionales. Trabajé con APIs, microservicios, identidad, IoT y despliegues contenedorizados, además de administrar pipelines y servicios internos.',
		descriptionEn: 'I designed and developed backend solutions for European and national projects. I worked with APIs, microservices, identity, IoT and containerized deployments, as well as pipelines and internal services.',
		highlightsEs: [
			'Como investigador junior, desarrollé y mantuve APIs y servicios en Python, Java y Go. Trabajé con repositorios Git, pipelines de Jenkins, scripts en Bash y autenticación con Keycloak.',
			'En el TFG desarrollé un agente MQTT en Python para normalizar datos LoRaWAN y publicarlos en Orion-LD. También amplié el servicio de ingesta y la API de consulta para incorporar InfluxDB.',
			'Durante las prácticas implementé desde cero un punto de administración de políticas XACML con Flask y Docker para MASTERPIECE. También desarrollé la ingesta de notificaciones de Orion-LD en Elasticsearch y una API de consulta.',
			'Participación en proyectos de I+D+i como UNIMAAS, MAS4CARE, EDS4AGRO y MASTERPIECE.',
		],
		highlightsEn: [
			'As a junior researcher, I developed and maintained APIs and services in Python, Java and Go. I also worked with Git repositories, Jenkins pipelines, Bash scripts and authentication with Keycloak.',
			'For my thesis, I built a Python MQTT agent to normalise LoRaWAN data and publish it to Orion-LD. I also extended the ingestion service and query API to support InfluxDB.',
			'During my internships, I built an XACML Policy Administration Point from scratch with Flask and Docker for MASTERPIECE. I also developed a service to ingest Orion-LD notifications into Elasticsearch and an API to query the data.',
			'Participation in R&D projects including UNIMAAS, MAS4CARE, EDS4AGRO and MASTERPIECE.',
		],
		technologies: ['Python', 'Java', 'Go', 'Flask', 'Docker', 'Kubernetes', 'Keycloak', 'Jenkins', 'FIWARE', 'MQTT'],
	},
];
---

<section id="experiencia" class="experience-section">
	<div class="section-shell">
		<header class="section-heading section-heading-on-dark reveal" data-section="02">
			<p class="section-eyebrow">{lang === 'en' ? "Experience" : "Experiencia"}</p>
			<h2>{lang === 'en' ? "Professional experience." : "Experiencia profesional."}</h2>
		</header>

		<div class="experience-list">
			{roles.map((role, index) => (
				<article class="experience-entry reveal" id={role.current ? 'lynx-tech' : 'odin-solutions'}>
					<div class="experience-rail">
						<span class="entry-index">0{index + 1}</span>
						{!role.stages && <span class="entry-period">{lang === 'en' ? role.periodEn : role.periodEs}</span>}
					</div>
					<div class="experience-main">
						<header>
							<div class="company-line">
								<h3>{role.company}</h3>
								{role.current && <span class="current-badge">{lang === 'en' ? "Current" : "Actual"}</span>}
							</div>
							{role.stages ? (
								<dl class="role-stages">
									{role.stages.map((stage) => (
										<div><dt>{stage[lang][0]}</dt><dd class="entry-period">{stage[lang][1]}</dd></div>
									))}
								</dl>
							) : <p class="role-title">{lang === 'en' ? role.titleEn : role.titleEs}</p>}
						</header>

						<p class="role-description">{lang === 'en' ? role.descriptionEn : role.descriptionEs}</p>

						<ul class="technology-list" aria-label={lang === 'en' ? "Technologies" : "Tecnologías"}>
							{role.technologies.map((technology) => <li>{technology}</li>)}
						</ul>

						<details class="role-details" open={role.current}>
							<summary>
								<span>{lang === 'en' ? `My work at ${role.company}` : `Mi trabajo en ${role.company}`}</span>
								<span class="details-icon" aria-hidden="true">+</span>
							</summary>
							<ol>
								{role.highlightsEs.map((highlight, highlightIndex) => (
									<li>{lang === 'en' ? role.highlightsEn[highlightIndex] : highlight}</li>
								))}
							</ol>
						</details>
						{!role.current && <div class="role-project-links">
							<a href="#proyecto-mqtt">{lang === 'en' ? 'MQTT agent project' : 'Proyecto del agente MQTT'} <span aria-hidden="true">↓</span></a>
							<a href="#proyecto-xacml">{lang === 'en' ? 'XACML project' : 'Proyecto XACML'} <span aria-hidden="true">↓</span></a>
						</div>}
					</div>
				</article>
			))}
		</div>
		<figure class="recommendation reveal">
			<figcaption><span>{lang === 'en' ? 'A reference from Odin Solutions' : 'Una referencia de Odin Solutions'}</span><span>José Trigueros · CEO</span><time datetime="2025-11-13">{lang === 'en' ? '13 November 2025' : '13 de noviembre de 2025'}</time></figcaption>
			<blockquote><p>{lang === 'en' ? '“He has strong analytical skills and a good understanding of the tools and methodologies related to cybersecurity.”' : '«Posee una marcada capacidad analítica y una buena comprensión de las herramientas y metodologías relacionadas con la ciberseguridad.»'}</p></blockquote>
			<p class="recommendation-note">
				{lang === 'en' ? 'Excerpt translated from the Spanish original.' : 'Extracto de la carta de recomendación.'}<br />
				<a href="/Carta-recomendacion-Odin-publica.pdf" target="_blank" rel="noopener noreferrer" type="application/pdf">{lang === 'en' ? 'Read the letter · public copy, PDF in Spanish' : 'Leer la carta · copia pública, PDF'}<span class="sr-only">{lang === 'en' ? ', opens in a new tab' : ', se abre en otra pestaña'}</span></a>
			</p>
		</figure>
	</div>
</section>
