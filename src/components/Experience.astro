---
const roles = [
	{
		company: 'Lynx Tech',
		titleEs: 'Software Engineering Analyst I',
		titleEn: 'Software Engineering Analyst I',
		periodEs: 'Noviembre 2025 — Presente',
		periodEn: 'November 2025 — Present',
		current: true,
		descriptionEs: 'Desarrollo una plataforma de detección AML basada en inteligencia artificial, Big Data y procesamiento en tiempo real para entornos financieros. Mi trabajo se centra en el desarrollo, mantenimiento y optimización de aplicaciones cloud, con participación puntual en el análisis de requisitos y el diseño de soluciones.',
		descriptionEn: 'I develop an AML detection platform based on artificial intelligence, Big Data and real-time processing for financial environments. My work focuses on the development, maintenance and optimization of cloud applications, with occasional involvement in requirements analysis and solution design.',
		highlightsEs: [
			'Apoyo puntual en el análisis de requisitos y el diseño de soluciones cloud para entornos financieros.',
			'Desarrollo y mantenimiento de servicios orientados a detección AML en tiempo real.',
			'Optimización de rendimiento, testing automático y diagnóstico de incidencias.',
		],
		highlightsEn: [
			'Occasional support in requirements analysis and cloud solution design for financial environments.',
			'Development and maintenance of real-time AML detection services.',
			'Performance optimization, automated testing and incident diagnosis.',
		],
		technologies: ['Python', 'REST APIs', 'Elasticsearch', 'SQL', 'PyTest', 'CI/CD', 'Big Data', 'AI'],
	},
	{
		company: 'Odin Solutions',
		titleEs: 'Investigador junior',
		titleEn: 'Junior Researcher',
		periodEs: 'Febrero 2023 — Noviembre 2025',
		periodEn: 'February 2023 — November 2025',
		current: false,
		descriptionEs: 'Diseño y desarrollo de soluciones backend para proyectos europeos y nacionales. Trabajé con APIs, microservicios, identidad, IoT y despliegues contenedorizados, además de administrar pipelines y servicios internos.',
		descriptionEn: 'I designed and developed backend solutions for European and national projects. I worked with APIs, microservices, identity, IoT and containerized deployments, as well as pipelines and internal services.',
		highlightsEs: [
			'Punto de Administración de Políticas XACML desarrollado desde cero con Flask y Docker para MASTERPIECE.',
			'Agente MQTT LoRaWAN con aproximadamente un 46 % menos de consumo medio de recursos frente a la media de agentes de código abierto.',
			'Repositorios Git, pipelines de Jenkins, scripts en Bash y administración de Keycloak.',
		],
		highlightsEn: [
			'XACML Policy Administration Point built from scratch with Flask and Docker for MASTERPIECE.',
			'MQTT LoRaWAN agent with approximately 46% lower average resource usage than the average open-source agent.',
			'Git repositories, Jenkins pipelines, Bash scripts and Keycloak administration.',
		],
		technologies: ['Python', 'Java', 'Go', 'Flask', 'Docker', 'Kubernetes', 'Keycloak', 'Jenkins', 'FIWARE', 'MQTT'],
	},
];
---

<section id="experiencia" class="experience-section">
	<div class="section-shell">
		<header class="section-heading section-heading-on-dark reveal" data-section="02">
			<p class="section-eyebrow" data-en="Experience" data-es="Experiencia">Experiencia</p>
			<h2 data-en="Professional experience." data-es="Experiencia profesional.">Experiencia profesional.</h2>
			<p class="section-intro" data-en="Backend development in financial software, applied research and European technology projects." data-es="Desarrollo backend en software financiero, investigación aplicada y proyectos tecnológicos europeos.">Desarrollo backend en software financiero, investigación aplicada y proyectos tecnológicos europeos.</p>
		</header>

		<div class="experience-list">
			{roles.map((role, index) => (
				<article class="experience-entry reveal">
					<div class="experience-rail">
						<span class="entry-index">0{index + 1}</span>
						<span class="entry-period" data-en={role.periodEn} data-es={role.periodEs}>{role.periodEs}</span>
					</div>
					<div class="experience-main">
						<header>
							<div class="company-line">
								<p>{role.company}</p>
								{role.current && <span class="current-badge" data-en="Current" data-es="Actual">Actual</span>}
							</div>
							<h3 data-en={role.titleEn} data-es={role.titleEs}>{role.titleEs}</h3>
						</header>

						<p class="role-description" data-en={role.descriptionEn} data-es={role.descriptionEs}>{role.descriptionEs}</p>

						<ul class="technology-list" aria-label="Tecnologías" data-aria-en="Technologies" data-aria-es="Tecnologías">
							{role.technologies.map((technology) => <li>{technology}</li>)}
						</ul>

						<details class="role-details">
							<summary>
								<span data-en="More details" data-es="Más detalles">Más detalles</span>
								<span class="details-icon" aria-hidden="true">+</span>
							</summary>
							<ol>
								{role.highlightsEs.map((highlight, highlightIndex) => (
									<li data-en={role.highlightsEn[highlightIndex]} data-es={highlight}>{highlight}</li>
								))}
							</ol>
						</details>
					</div>
				</article>
			))}
		</div>
	</div>
</section>
