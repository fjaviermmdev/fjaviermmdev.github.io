---
import { cvPath, type Language } from '../lib/i18n';
interface Props { lang: Language }
const { lang } = Astro.props;
---

<section id="contacto" class="contact-section">
	<div class="contact-shell reveal">
		<div class="contact-heading">
		<p class="section-eyebrow">{lang === 'en' ? "Contact" : "Contacto"}</p>
		<h2>{lang === 'en' ? "Résumé and contact." : "Currículum y contacto."}</h2>
		<p class="contact-intro">{lang === 'en' ? "More about my experience in the CV. If you would like to get in touch, you can write to me directly." : "Mi experiencia, con más detalle, en el CV. Si quieres contactar conmigo, puedes escribirme directamente."}</p>
		</div>

		<div class="contact-primary">
			<a class="contact-cv" href={cvPath(lang)} data-cv-link target="_blank" rel="noopener noreferrer"><span>{lang === 'en' ? "View résumé" : "Ver currículum"}</span> <span aria-hidden="true">↗</span></a>
			<p class="cv-languages"><span>PDF · {lang === 'en' ? 'English' : 'Español'}</span><a href={cvPath(lang === 'en' ? 'es' : 'en')} lang={lang === 'en' ? 'es' : 'en'} target="_blank" rel="noopener noreferrer">{lang === 'en' ? 'CV en español' : 'CV in English'}</a></p>
		</div>

		<div class="contact-actions">
			<a class="contact-email" href="mailto:fjaviermm.dev@gmail.com">fjaviermm.dev@gmail.com</a>
			<a href="https://linkedin.com/in/fjaviermm" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
			<a href="https://github.com/fjaviermmdev" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
		</div>
	</div>
</section>
